# ── Core ──
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://erp:erp@localhost:5432/shop_erp
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3001
APP_TIMEZONE=Asia/Colombo

# ── Security (generate your own!) ──
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# openssl rand -base64 32   (encrypts repair device passcodes)
ENCRYPTION_KEY=
# Vendor console key, sent as the x-admin-key header
ADMIN_API_KEY=change-me-admin-key-24-chars-min

# ── SaaS ──
TRIAL_DAYS=14
PUBLIC_TRACKING_URL=http://localhost:3001/track

# ── Notifications ──
# log = print messages and mark them sent (development); live = call the providers below
NOTIFICATIONS_DRIVER=log
# Your Android SMS gateway: POST {to, message} with Bearer token
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# n8n webhook that sends WhatsApp messages: POST {to, message, event}
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# ── Cloudflare R2 (repair photos) ──
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
